import os
import json
import urllib.request

def check_gumroad_ping(token):
    url = f"https://api.gumroad.com/v2/products?access_token={token}"
    try:
        req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=30) as response:
            data = json.loads(response.read().decode("utf-8"))
            return data.get("success", False)
    except Exception as e:
        print(f"Gumroad Verification Error: {e}")
    return False

def check_lemon_squeezy_ping(api_key):
    url = "https://api.lemonsqueezy.com/v1/stores"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Accept": "application/vnd.api+json",
        "Content-Type": "application/vnd.api+json"
    }
    try:
        req = urllib.request.Request(url, headers=headers, method="GET")
        with urllib.request.urlopen(req, timeout=30) as response:
            data = json.loads(response.read().decode("utf-8"))
            stores = data.get("data", [])
            return len(stores) > 0
    except Exception as e:
        print(f"Lemon Squeezy Verification Error: {e}")
    return False

if __name__ == "__main__":
    print("Running automated storefront configuration and payout verification...")
    
    gumroad_token = os.environ.get("GUMROAD_ACCESS_TOKEN")
    ls_api_key = os.environ.get("LEMON_SQUEEZY_API_KEY")
    
    if not gumroad_token or not ls_api_key:
        print("CRITICAL ERROR: Missing API keys for verification.")
        exit(1)
        
    gumroad_ok = check_gumroad_ping(gumroad_token)
    lemon_ok = check_lemon_squeezy_ping(ls_api_key)
    
    print(f"\n--- VERIFICATION RESULTS ---")
    print(f"Gumroad API & Auth Connection: {'PASS 🟢' if gumroad_ok else 'FAIL 🔴'}")
    print(f"Lemon Squeezy Store & Payout Link: {'PASS 🟢' if lemon_ok else 'FAIL 🔴'}")
    
    if not gumroad_ok or not lemon_ok:
        exit(1)
    else:
        print("\nAll storefront channels verified and ready for live transactions!")
